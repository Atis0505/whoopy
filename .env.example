# Whoopy – környezeti változók (másold .env néven)

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
API_KEY=change-me-api-key
ADMIN_EMAIL=admin@whoopy.local
ADMIN_PASSWORD=change-me-admin-password

# SQLite (dev) vagy Postgres (prod)
# DATABASE_URL=sqlite:///C:/Users/korom/Személyes/taxonomy-marketplace/marketplace.db
# DATABASE_URL=postgresql+psycopg2://whoopy:whoopy@127.0.0.1:5432/whoopy

HOST=127.0.0.1
PORT=8090
PUBLIC_BASE_URL=http://127.0.0.1:8090
APP_DOMAIN=whoopy.hu

# Media / CDN (üres = PUBLIC_BASE_URL). Cloudflare/nginx elé rakva pl.:
# MEDIA_PUBLIC_BASE=https://cdn.whoopy.hu

# ERP bridge (státusz + autosync trigger az adminban)
ERP_ENABLED=false
ERP_API_BASE=http://127.0.0.1:8010/api/v1

# Production hardening
# ENVIRONMENT=production
# FORCE_HTTPS=true
# SESSION_HTTPS_ONLY=true
# SESSION_SAME_SITE=lax
# TRUSTED_HOSTS=whoopy.hu,www.whoopy.hu,127.0.0.1
# CORS_ORIGINS=https://whoopy.hu
# SEED_ON_STARTUP=false
# DOCS_ENABLED=false
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_API_PER_MINUTE=120

# Payments
PAYMENT_PROVIDER=auto
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SimplePay sandbox:
# PAYMENT_PROVIDER=simplepay
# SIMPLEPAY_MERCHANT=PUBLICTESTHUF
# SIMPLEPAY_SECRET_KEY=...
# SIMPLEPAY_SANDBOX=true
# SIMPLEPAY_ALLOW_DEMO_FALLBACK=true
# Éles: SIMPLEPAY_SANDBOX=false + SIMPLEPAY_ALLOW_DEMO_FALLBACK=false

# Webhooks → ERP
WEBHOOK_ENABLED=false
WEBHOOK_URL=http://127.0.0.1:8010/api/v1/webhooks/whoopy
WEBHOOK_SECRET=change-me-webhook-secret
