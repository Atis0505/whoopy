# Whoopy – környezeti változók (másold .env néven)

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
API_KEY=change-me-api-key
ADMIN_EMAIL=admin@whoopy.local
ADMIN_PASSWORD=change-me-admin-password

# SQLite (dev) vagy Postgres (prod)
# DATABASE_URL=sqlite:///C:/Users/korom/Személyes/taxonomy-marketplace/marketplace.db
# DATABASE_URL=postgresql+psycopg2://whoopy:whoopy@127.0.0.1:5432/whoopy

HOST=127.0.0.1
PORT=8090
PUBLIC_BASE_URL=http://127.0.0.1:8090
APP_DOMAIN=whoopy.hu

# Media / CDN (üres = PUBLIC_BASE_URL). Cloudflare/nginx elé rakva pl.:
# MEDIA_PUBLIC_BASE=https://cdn.whoopy.hu

# Optional S3 / Cloudflare R2 object storage
# S3_ENDPOINT_URL=https://ACCOUNT.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=whoopy-media
# S3_REGION=auto
# S3_PUBLIC_BASE=https://cdn.whoopy.hu

# ERP bridge (státusz + autosync trigger az adminban)
ERP_ENABLED=false
ERP_API_BASE=http://127.0.0.1:8010/api/v1

# Production hardening
# ENVIRONMENT=production
# FORCE_HTTPS=true
# SESSION_HTTPS_ONLY=true
# SESSION_SAME_SITE=lax
# TRUSTED_HOSTS=whoopy.hu,www.whoopy.hu,127.0.0.1
# CORS_ORIGINS=https://whoopy.hu
# SEED_ON_STARTUP=false
# DOCS_ENABLED=false
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_API_PER_MINUTE=120

# Payments
PAYMENT_PROVIDER=auto
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SimplePay sandbox:
# PAYMENT_PROVIDER=simplepay
# SIMPLEPAY_MERCHANT=PUBLICTESTHUF
# SIMPLEPAY_SECRET_KEY=...
# SIMPLEPAY_SANDBOX=true
# SIMPLEPAY_ALLOW_DEMO_FALLBACK=true
# Éles: SIMPLEPAY_SANDBOX=false + SIMPLEPAY_ALLOW_DEMO_FALLBACK=false

# SMTP (opcionális — üresen data/email_outbox)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=info@whoopy.hu
# SMTP_USE_TLS=true

# Számlázz.hu Agent (https://docs.szamlazz.hu/) — üres kulcs = dry-run XML outbox
# SZAMLAZZ_ENABLED=false
# SZAMLAZZ_AGENT_KEY=
# SZAMLAZZ_API_URL=https://www.szamlazz.hu/szamla/
# SZAMLAZZ_ESZAMLA=true
# SZAMLAZZ_DOWNLOAD_PDF=true
# SZAMLAZZ_AUTO_ON_PAID=true
